{
  "name": "gamewiki-sole-template",
  "version": "2.0.7",
  "type": "module",
  "description": "Open-source game wiki site template. Astro + Vercel. Static-first, fast, beginner-friendly.",
  "license": "MIT",
  "homepage": "https://github.com/HaydenGuo/GameWikiSoleTemplate",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaydenGuo/GameWikiSoleTemplate.git"
  },
  "bugs": {
    "url": "https://github.com/HaydenGuo/GameWikiSoleTemplate/issues"
  },
  "keywords": [
    "astro",
    "vercel",
    "game-wiki",
    "wiki-template",
    "seo",
    "i18n",
    "mdx",
    "tailwindcss",
    "static-site",
    "wiki",
    "giscus",
    "lighthouse-100"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "dev": "astro dev",
    "dev:vercel": "vercel dev --local",
    "prebuild": "tsx scripts/generate-popular-slug-manifest.ts",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.ts,.astro",
    "lint:fix": "eslint . --ext .js,.ts,.astro --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e-apply-template.mjs",
    "check-sitemap": "tsx scripts/check-sitemap.ts",
    "check-config": "tsx scripts/check-config.ts",
    "new-post": "tsx scripts/new-post.ts",
    "bulk-new-posts": "tsx scripts/bulk-new-posts.ts",
    "gen-assets": "tsx scripts/gen-assets.ts",
    "submit-indexnow": "tsx scripts/submit-indexnow.ts",
    "template-audit": "tsx scripts/template-audit.ts",
    "template-baseline:create": "tsx scripts/template-baseline.ts create",
    "template-baseline:check": "tsx scripts/template-baseline.ts check",
    "check-publish-scope": "tsx scripts/check-publish-scope.ts --config site.publish.example.json",
    "new-locale": "tsx scripts/new-locale.ts",
    "apply-template": "tsx scripts/apply-template.ts",
    "check-i18n": "tsx scripts/check-i18n.ts",
    "check-links": "tsx scripts/check-links.ts",
    "check-content": "tsx scripts/check-content.ts",
    "refresh-audit": "tsx scripts/refresh-audit.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.14",
    "@astrojs/rss": "^4.0.11",
    "@astrojs/sitemap": "^3.2.1",
    "@neondatabase/serverless": "^1.2.0",
    "astro": "^5.6.1",
    "astro-icon": "^1.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/tailwind": "^5.1.4",
    "@iconify-json/lucide": "^1.2.123",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "satori": "^0.33.3",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^64.5.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "private": true
}

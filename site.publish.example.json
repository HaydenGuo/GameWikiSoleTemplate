{
  "siteName": "your-game-wiki",
  "domain": "example.com",
  "canonicalHost": "example.com",
  "publishPaths": [
    "site.publish.json",
    "src/**",
    "public/**",
    "scripts/**",
    "functions/**",
    "migrations/**",
    "tests/**",
    "docs/template-baseline.json",
    "package.json",
    "pnpm-lock.yaml"
  ],
  "envSync": [
    {
      "name": "PUBLIC_YOURGAME_ADSTERRA_KEY_NATIVE",
      "sourceEnv": "PUBLIC_YOURGAME_ADSTERRA_KEY_NATIVE",
      "target": ["production"],
      "sensitive": false
    }
  ],
  "github": {
    "enabled": false,
    "owner": "your-account",
    "repo": "your-game-wiki",
    "defaultBranch": "main"
  },
  "analytics": {
    "enablePropertySetup": false,
    "gaIdEnv": ""
  },
  "searchConsole": {
    "enabled": false,
    "enablePropertySetup": false,
    "siteUrl": "sc-domain:example.com",
    "sitemapUrl": "https://example.com/sitemap-index.xml"
  }
}

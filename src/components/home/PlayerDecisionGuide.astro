---
/**
 * PlayerDecisionGuide — image-led player routes below QuickStart.
 *
 * All labels, descriptions, images, and links come from the consuming site's
 * locale data so the component stays generic across games and languages.
 */
interface DecisionDirection {
  title: string;
  question: string;
  href: string;
}

interface DecisionGroup {
  label: string;
  image?: string;
  directions: DecisionDirection[];
}

interface Props {
  title: string;
  eyebrow?: string;
  description?: string;
  routeLabel?: string;
  groups?: DecisionGroup[];
}

const {
  title,
  eyebrow = 'Choose your route',
  description,
  routeLabel = 'routes',
  groups = [],
} = Astro.props;
---

{groups.length > 0 && (
  <section class="section border-t border-border" aria-labelledby="player-decision-guide-title">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{eyebrow}</p>
      <h2 id="player-decision-guide-title" class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
      {description && <p class="mt-2 max-w-2xl text-sm leading-6 text-muted-foreground md:text-base">{description}</p>}
    </div>

    <div class="mt-7 grid gap-5 lg:grid-cols-3">
      {groups.slice(0, 3).map((group, groupIndex) => (
        <article class="decision-group-card overflow-hidden rounded-2xl border border-border bg-card shadow-sm transition-shadow hover:shadow-md" aria-labelledby={`decision-group-${groupIndex}`}>
          <div class="relative isolate flex h-48 flex-col justify-between overflow-hidden bg-foreground p-5 sm:h-52">
            {group.image && (
              <img
                src={group.image}
                alt=""
                loading="lazy"
                decoding="async"
                class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-500 motion-reduce:transition-none hover:scale-[1.03]"
              />
            )}
            <div aria-hidden="true" class="absolute inset-0 -z-10 bg-gradient-to-b from-black/45 via-black/10 to-black/75" />
            <div class="relative z-10 flex items-start justify-end">
              <span class="rounded-full border border-white/40 bg-black/20 px-3 py-1 text-[0.68rem] font-bold uppercase tracking-[0.12em] text-white backdrop-blur-sm">
                {group.directions.length} {routeLabel}
              </span>
            </div>
            <h3 id={`decision-group-${groupIndex}`} class="relative z-10 text-2xl font-bold tracking-tight text-white drop-shadow-sm">{group.label}</h3>
          </div>

          <div class="space-y-1 p-3">
            {group.directions.slice(0, 3).map((direction) => (
              <a
                href={direction.href}
                class="group/route flex items-start gap-3 rounded-xl px-3 py-3.5 transition-colors hover:bg-muted/60 focus-visible:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-nav/50"
              >
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold leading-snug text-foreground transition-colors group-hover/route:text-nav">{direction.title}</span>
                  <span class="mt-1 block text-sm leading-snug text-muted-foreground">{direction.question}</span>
                </span>
                <span aria-hidden="true" class="mt-0.5 shrink-0 text-lg leading-none text-muted-foreground transition group-hover/route:translate-x-0.5 group-hover/route:text-nav">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
)}

---
/**
 * ExploreModules — renders the homepage content modules.
 *
 * Each module specifies a `displayType` that controls how its `highlights`
 * are rendered. We dispatch to the corresponding sub-component.
 *
 * Supported displayTypes (per PRD §6.5):
 *   - badge-list      → CodeCards (redeemable codes with badge)
 *   - steps    → StepByStep (numbered progression steps)
 *   - ranked-grid       → TierGrid (S/A/B/C ranked items)
 *   - labeled-cards       → CardList (simple labeled cards)
 *   - timeline        → Timeline (vertical timeline of dated events)
 *   - video-grid      → VideoGrid (2-column video thumbnail grid)
 *
 * v0.2: each module card is now a single clickable <a> (block-level) with
 * hover border feedback, replacing the cramped "View" link that sat on the
 * same line as the title. The whole tile navigates; an arrow in the footer
 * signals affordance.
 */
import { Icon } from 'astro-icon/components';
import CodeCards from './modules/CodeCards.astro';
import StepByStep from './modules/StepByStep.astro';
import TierGrid from './modules/TierGrid.astro';
import CardList from './modules/CardList.astro';
import Timeline from './modules/Timeline.astro';
import VideoGrid from './modules/VideoGrid.astro';
import { type Locale } from '~/i18n/routing';
import { localizePath } from '~/lib/url';
import { getUi } from '~/i18n/ui';

interface Props {
  modules: Array<{
    order: number;
    name: string;
    description: string;
    href: string;
    image?: string;
    displayType: string;
    // highlights 的字段结构由 displayType 决定(见各子组件 Props),
    // dispatcher 不假设具体字段。类型安全由各子组件内部的 Props
    // interface 保证(JSON 层不参与 TS 检查,见 spec §2.2)。
    highlights: Array<any>;
  }>;
  locale: Locale;
}
const { modules, locale } = Astro.props;
const sharedStrings = getUi(locale).shared as unknown as Record<string, any>;
const viewAll = sharedStrings.viewAll ?? 'View all';
---

<div class="home-explore-board grid gap-4 md:grid-cols-12 md:gap-5">
  {
    modules.map((m, index) => (
      <a
        href={localizePath(m.href, locale)}
        class:list={[
          'home-explore-card group block overflow-hidden border border-border bg-card text-card-foreground transition-colors hover:border-nav focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nav focus-visible:ring-offset-2',
          index === 0 ? (modules.length === 1 ? 'md:col-span-12' : 'md:col-span-7') : 'md:col-span-5',
        ]}
        style={index === 0 && modules.length > 1 ? `grid-row: span ${modules.length - 1} / span ${modules.length - 1}` : undefined}
      >
        {m.image && <img src={m.image} alt={m.name} class:list={['w-full object-cover transition-transform duration-500 group-hover:scale-[1.025] motion-reduce:transition-none', index === 0 ? 'aspect-[16/8]' : 'aspect-[16/7]']} loading="lazy" />}
        <div class:list={['home-explore-copy', index === 0 ? 'p-5 md:p-7' : 'p-4 md:p-5']}>
        <p class="home-section-kicker">{String(m.order).padStart(2, '0')}</p>
        <h3 class:list={['mt-1 font-bold leading-snug tracking-tight', index === 0 ? 'text-2xl md:text-3xl' : 'text-lg']}>{m.name}</h3>
        <p class="mt-1 text-sm text-muted-foreground">{m.description}</p>

        <div class="mt-4">
          {m.displayType === 'badge-list' && <CodeCards highlights={m.highlights} />}
          {m.displayType === 'steps' && <StepByStep highlights={m.highlights} />}
          {m.displayType === 'ranked-grid' && <TierGrid highlights={m.highlights} />}
          {m.displayType === 'labeled-cards' && <CardList highlights={m.highlights} />}
          {m.displayType === 'timeline' && <Timeline highlights={m.highlights} />}
          {m.displayType === 'video-grid' && <VideoGrid highlights={m.highlights} />}
        </div>

        <p class="mt-4 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-foreground">
          <span class="border-b border-transparent transition group-hover:border-nav">{viewAll}</span>
          <Icon
            name="lucide:arrow-right"
            class="h-3 w-3 transition group-hover:translate-x-0.5"
          />
        </p>
        </div>
      </a>
    ))
  }
</div>

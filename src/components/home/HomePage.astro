    closingCta.title && (
      <section class="section section-full-bleed border-t border-border" data-home-closing-cta-section>
        <div class="home-closing-cta relative isolate flex min-h-[22rem] flex-col justify-center overflow-hidden rounded-xl border border-white/20 p-8 text-center shadow-xl shadow-black/10 md:min-h-[27rem] md:p-12">
          <div
            class="home-closing-cta-track"
            data-closing-cta-track
            aria-hidden="true"
            style={`width: ${closingCtaFrames.length * 100}%;`}
          >
            {closingCtaFrames.map((src) => (
              <div class="home-closing-cta-slide" style={`flex-basis: ${100 / closingCtaFrames.length}%; min-width: ${100 / closingCtaFrames.length}%;`}>
                <img src={src} alt="" loading="eager" decoding="async" />
              </div>
            ))}
          </div>
          <div class="relative z-10">
            <h2 class="game-art-cta-title text-2xl font-bold text-white drop-shadow-md md:text-3xl">{closingCta.title}</h2>
            <p class="game-art-cta-description mx-auto mt-2 max-w-xl text-white/85 drop-shadow-md">{closingCta.description}</p>
          <div class="mt-6 flex flex-wrap justify-center gap-3">
            <a
              href={site.social.official}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
              data-home-slot="closing_cta"
              data-home-item="official"
            >
              {closingCta.primary}
            </a>
            {closingCta.secondary && site.social.discord && (
              <a
                href={site.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-outline"
                data-home-slot="closing_cta"
                data-home-item="discord"
              >
              {closingCta.secondary}
              </a>
            )}
          </div>
          </div>
          <button
            type="button"
            class="home-closing-cta-control home-closing-cta-control-left"
            data-closing-cta-prev
            aria-label="Previous featured image"
          >
            <span class="home-closing-cta-arrow home-closing-cta-arrow-left" aria-hidden="true"></span>
          </button>
          <button
            type="button"
            class="home-closing-cta-control home-closing-cta-control-right"
            data-closing-cta-next
            aria-label="Next featured image"
          >
            <span class="home-closing-cta-arrow home-closing-cta-arrow-right" aria-hidden="true"></span>
          </button>
        </div>
      </section>
    )
  }
</LocaleLayout>

<script is:inline>
  (() => {
  const statsRoot = document.querySelector('[data-home-steam-app-id]');
  if (statsRoot) {
    const labels = JSON.parse(statsRoot.dataset.homeSteamCopy || '{}');
    const appId = statsRoot.dataset.homeSteamAppId || '';
    const game = statsRoot.dataset.homeSteamGame || '';
    const value = (key, text) => {
      const target = statsRoot.querySelector(`[data-home-steam-value="${key}"]`);
      if (target) target.textContent = text;
    };
    const dealLink = statsRoot.querySelector('[data-home-steam-deal-link]');
    const dealCard = statsRoot.querySelector('[data-home-steam-deal-card]');
    const unavailable = () => {
      for (const key of ['rank', 'peak', 'players', 'steamPrice', 'deal']) value(key, labels.unavailable);
      statsRoot.querySelector('dl')?.setAttribute('aria-busy', 'false');
    };
    if (appId) {
      fetch(`/api/game-deals?appid=${encodeURIComponent(appId)}`, { headers: { accept: 'application/json' } })
        .then((response) => { if (!response.ok) throw new Error('Steam data unavailable'); return response.json(); })
        .then((data) => {
          const steam = data.steam;
          const best = data.offers?.[0];
          value('rank', steam?.rank ? Number(steam.rank).toLocaleString() : labels.unavailable);
          value('peak', steam?.dailyPeak == null ? labels.unavailable : Number(steam.dailyPeak).toLocaleString());
          value('players', steam?.currentPlayers == null ? labels.unavailable : Number(steam.currentPlayers).toLocaleString());
          value('steamPrice', steam?.formattedPrice || (steam?.price != null ? new Intl.NumberFormat(undefined, { style: 'currency', currency: steam.currency || 'USD' }).format(Number(steam.price)) : labels.unavailable));
          const discountPercent = best?.price != null && Number(steam?.price) > 0
            ? Math.max(0, Math.round((1 - Number(best.price) / Number(steam.price)) * 100))
            : null;
          value('deal', discountPercent !== null && discountPercent > 0 ? `${discountPercent}% ${labels.off}` : labels.noDeal);
          if (dealLink && best?.actionUrl) {
            try {
              const destination = new URL(best.actionUrl);
              if (destination.protocol === 'https:' || destination.protocol === 'http:') {
                dealLink.href = destination.href;
                if (dealCard) dealCard.hidden = false;
              }
            } catch {}
          }
          statsRoot.querySelector('dl')?.setAttribute('aria-busy', 'false');
        })
        .catch(unavailable);
    }
  }
  })();
</script>

<script is:inline>
  const closingCta = document.querySelector('[data-closing-cta-track]')?.closest('.home-closing-cta');
  const closingCtaTrack = closingCta?.querySelector('[data-closing-cta-track]');
  const closingCtaPrevious = closingCta?.querySelector('[data-closing-cta-prev]');
  const closingCtaNext = closingCta?.querySelector('[data-closing-cta-next]');

  if (closingCta && closingCtaTrack && closingCtaPrevious && closingCtaNext) {
    let trackIndex = 1;
    let autoTimer;
    let transitionTimer;
    let pendingResetIndex;
    let isTransitioning = false;
    const frameCount = closingCtaTrack.querySelectorAll('.home-closing-cta-slide').length;
    const frameStep = 100 / frameCount;

    const setTrackIndex = (nextIndex, instant = false) => {
      trackIndex = Math.max(0, Math.min(frameCount - 1, nextIndex));
      if (instant) closingCtaTrack.style.transition = 'none';
      closingCtaTrack.style.transform = `translate3d(-${trackIndex * frameStep}%, 0, 0)`;
    };

    const finishTransition = () => {
      if (transitionTimer) window.clearTimeout(transitionTimer);
      transitionTimer = undefined;
      isTransitioning = false;

      if (pendingResetIndex === undefined) return;
      const resetIndex = pendingResetIndex;
      pendingResetIndex = undefined;
      setTrackIndex(resetIndex, true);
      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => {
          closingCtaTrack.style.removeProperty('transition');
        });
      });
    };

    const resetAutoTimer = () => {
      if (autoTimer) window.clearInterval(autoTimer);
      autoTimer = window.setInterval(() => {
        if (!isTransitioning) move(1);
      }, 3000);
    };

    const move = (direction) => {
      if (isTransitioning) return;
      const nextIndex = trackIndex + direction;
      if (nextIndex < 0 || nextIndex >= frameCount) return;
      pendingResetIndex = nextIndex === frameCount - 1 ? 1 : nextIndex === 0 ? frameCount - 2 : undefined;
      isTransitioning = true;
      setTrackIndex(nextIndex);
      resetAutoTimer();
      transitionTimer = window.setTimeout(finishTransition, 700);
    };

    closingCtaPrevious.addEventListener('click', () => move(-1));
    closingCtaNext.addEventListener('click', () => move(1));
    closingCta.addEventListener('keydown', (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey) return;
      const target = event.target;
      if (target instanceof HTMLElement && target.closest('input, textarea, select, [contenteditable="true"]')) return;
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        move(-1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        move(1);
      }
    });
    window.addEventListener('resize', () => setTrackIndex(trackIndex));
    closingCtaTrack.addEventListener('transitionend', (event) => {
      if (event.propertyName !== 'transform' || !isTransitioning) return;
      finishTransition();
    });

    setTrackIndex(trackIndex);
    resetAutoTimer();
  }
</script>

{gaId && (
  <script>
    import { trackHomepageClick } from '~/lib/homepage-analytics';

    document.querySelectorAll<HTMLAnchorElement>('[data-home-slot]').forEach((element) => {
      element.addEventListener('click', () => {
        const target = new URL(element.href, window.location.origin);

        trackHomepageClick(window, {
          slot: element.dataset.homeSlot || 'unknown',
          item: element.dataset.homeItem || '',
          targetPath: target.pathname,
          variant: 'home-v1',
          locale: document.documentElement.lang || 'en',
        });
      });
    });
  </script>
)}


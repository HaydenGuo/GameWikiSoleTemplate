---
/**
 * Contextual second-level navigation.
 *
 * The primary header selects a content category. When that category has more
 * than eight articles, this rail exposes its article links below the header.
 */
import { getUi } from '~/i18n/ui';
import { getDynamicNavigation } from '~/lib/navigation';
import { localizePath } from '~/lib/url';
import type { Locale } from '~/i18n/routing';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared as unknown as Record<string, string>;
const groups = await getDynamicNavigation(locale, nav);
const activeGroup = groups.find((group) => {
  const path = localizePath(group.path, locale);
  return currentPath === path || currentPath.startsWith(path);
});
const SHOW_SECONDARY_NAV_AFTER = 8;
const links =
  activeGroup && activeGroup.count > SHOW_SECONDARY_NAV_AFTER
    ? [
        { title: shared.viewAll ?? `All ${activeGroup.label}`, path: activeGroup.path },
        ...activeGroup.entries.map((entry) => ({ title: entry.title, path: entry.path })),
      ]
    : [];
---

{links.length > 0 && (
  <nav
    class="border-b border-border bg-muted/20"
    aria-label={shared.sectionNavigation ?? 'Section navigation'}
  >
    <div class="mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-4 py-2 text-xs">
      <span class="flex shrink-0 items-center font-semibold uppercase tracking-wider text-muted-foreground">
        {activeGroup ? activeGroup.label : shared.quickLinks ?? 'Quick links'}
      </span>
      <span class="h-4 w-px shrink-0 bg-border" aria-hidden="true"></span>
      {links.map((link) => {
        const href = localizePath(link.path, locale);
        const isActive = currentPath === href;
        return (
          <a
            href={href}
            class:list={[
              'shrink-0 rounded-full border px-3 py-1.5 transition',
              isActive
                ? 'border-nav/50 bg-nav/10 font-medium text-nav'
                : 'border-transparent text-muted-foreground hover:border-border hover:bg-card hover:text-foreground',
            ]}
            aria-current={isActive ? 'page' : undefined}
          >
            {link.title}
          </a>
        );
      })}
    </div>
  </nav>
)}

---
interface Props {
  label: string;
  src: string;
  alt?: string;
}

const { label, src, alt = `${label} icon` } = Astro.props;
---

<span class="item-inline-icon" data-item-inline-icon>
  <img
    class="item-inline-icon__image"
    src={src}
    alt={alt}
    width="28"
    height="28"
    loading="lazy"
    decoding="async"
  />
  <span>{label}</span>
</span>

<style>
  .item-inline-icon {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
    vertical-align: middle;
    font-weight: 600;
  }

  .item-inline-icon__image {
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 1.75rem;
    object-fit: contain;
    border-radius: 0.35rem;
    background: hsl(var(--muted) / 0.55);
    box-shadow: inset 0 0 0 1px hsl(var(--border) / 0.75);
  }
</style>

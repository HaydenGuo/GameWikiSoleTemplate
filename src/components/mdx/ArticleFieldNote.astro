---
import { Icon } from 'astro-icon/components';

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  icon?: string;
  image?: string;
  imageAlt?: string;
  imageOrientation?: 'landscape' | 'portrait' | 'square';
  chips?: string[];
  chipsAriaLabel?: string;
}

const { eyebrow, title, body, icon, image, imageAlt, imageOrientation = 'landscape', chips = [], chipsAriaLabel = title } = Astro.props;
const iconAllowlist = new Set(['lucide:map', 'lucide:scroll-text', 'lucide:flask-conical', 'lucide:shield-check', 'lucide:rotate-ccw']);
const safeIcon = icon && iconAllowlist.has(icon) ? icon : 'lucide:scroll-text';
const mediaClassName = image ? 'article-field-note--has-media' : 'article-field-note--no-media';
---

<aside class={`not-prose article-field-note ${mediaClassName}`} aria-label={title}>
  <div class="article-field-note__anchor">
    {image ? (
      <div class={`article-field-note__thumb article-field-note__thumb--${imageOrientation}`}>
        <img class="article-field-note__image" src={image} alt={imageAlt ?? title} loading="lazy" decoding="async" />
      </div>
    ) : (
      <Icon name={safeIcon} class="article-field-note__icon" aria-hidden="true" />
    )}
  </div>
  <div class="article-field-note__copy">
    <p class="article-field-note__eyebrow">{eyebrow}</p>
    <h3>{title}</h3>
    <p>{body}</p>
    {chips.length > 0 && (
      <ul class="article-field-note__chips" aria-label={chipsAriaLabel}>
        {chips.slice(0, 5).map((chip) => <li>{chip}</li>)}
      </ul>
    )}
  </div>
</aside>

<style>
  .article-field-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.1rem;
    border: 1px solid hsl(var(--border));
    border-left: 3px solid hsl(var(--brand) / 0.75);
    border-radius: 0.25rem 0.85rem 0.25rem 0.25rem;
    background: linear-gradient(135deg, hsl(var(--card)), hsl(var(--brand) / 0.06));
  }

  .article-field-note__anchor { display: grid; place-items: center; min-width: 3.5rem; }
  .article-field-note__icon { width: 2rem; height: 2rem; color: hsl(var(--brand-text)); }
  .article-field-note__thumb { width: 5rem; overflow: hidden; border-radius: 0.5rem; }
  .article-field-note__thumb--landscape { aspect-ratio: 16 / 9; }
  .article-field-note__thumb--portrait { aspect-ratio: 4 / 5; }
  .article-field-note__thumb--square { aspect-ratio: 1; }
  .article-field-note__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .article-field-note__copy { min-width: 0; }
  .article-field-note__eyebrow { margin: 0 0 0.35rem; color: hsl(var(--brand-text)); font-size: 0.68rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; }
  .article-field-note h3 { margin: 0; font-size: 1.15rem; font-weight: 750; line-height: 1.25; }
  .article-field-note__copy > p:not(.article-field-note__eyebrow) { margin: 0.5rem 0 0; color: hsl(var(--muted-foreground)); font-size: 0.9rem; line-height: 1.55; }
  .article-field-note__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.75rem 0 0; padding: 0; list-style: none; }
  .article-field-note__chips li { border: 1px solid hsl(var(--border)); border-radius: 999px; padding: 0.25rem 0.55rem; color: hsl(var(--foreground)); font-size: 0.72rem; font-weight: 650; }

  @media (max-width: 560px) {
    .article-field-note { grid-template-columns: 1fr; }
    .article-field-note__anchor { justify-items: start; }
  }
</style>

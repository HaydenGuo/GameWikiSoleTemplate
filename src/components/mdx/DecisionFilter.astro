---
interface FilterItem {
  label: string;
  value: string;
  answer: string;
  detail: string;
}

interface Labels {
  eyebrow: string;
  all: string;
  prompt: string;
  empty: string;
}

interface Props {
  title: string;
  prompt?: string;
  emptyLabel?: string;
  items: FilterItem[];
  labels: Labels;
}

const { title, prompt, emptyLabel, items, labels } = Astro.props;
const resolvedPrompt = prompt ?? labels.prompt;
const resolvedEmptyLabel = emptyLabel ?? labels.empty;
---

<section class="decision-filter not-prose" data-decision-filter>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-nav">{labels.eyebrow}</p>
      <h3 class="mt-1 text-lg font-bold">{title}</h3>
    </div>
    <label class="flex items-center gap-2 text-sm text-muted-foreground">
      <span>{resolvedPrompt}</span>
      <select data-decision-select class="rounded-md border border-border bg-background px-3 py-2 text-foreground">
        <option value="all">{labels.all}</option>
        {items.map((item) => <option value={item.value}>{item.label}</option>)}
      </select>
    </label>
  </div>
  <div class="mt-4 grid gap-3 md:grid-cols-2" data-decision-grid>
    {items.map((item) => (
      <article class="rounded-lg border border-border bg-background/70 p-4" data-decision-card data-match={item.value}>
        <h4 class="font-semibold">{item.label}</h4>
        <p class="mt-2 text-sm font-medium text-foreground">{item.answer}</p>
        <p class="mt-2 text-sm text-muted-foreground">{item.detail}</p>
      </article>
    ))}
  </div>
  <p class="mt-4 hidden rounded-md border border-dashed border-border p-3 text-sm text-muted-foreground" data-decision-empty>{resolvedEmptyLabel}</p>
</section>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-decision-filter]').forEach((root) => {
      const select = root.querySelector('[data-decision-select]');
      const cards = Array.from(root.querySelectorAll('[data-decision-card]'));
      const empty = root.querySelector('[data-decision-empty]');
      if (!(select instanceof HTMLSelectElement) || !empty) return;
      select.addEventListener('change', () => {
        const value = select.value;
        let visible = 0;
        cards.forEach((card) => {
          const show = value === 'all' || card.getAttribute('data-match') === value;
          card.classList.toggle('hidden', !show);
          if (show) visible += 1;
        });
        empty.classList.toggle('hidden', visible !== 0);
      });
    });
  })();
</script>

<style>
  .decision-filter {
    margin: 2rem 0;
    border: 1px solid hsl(var(--border));
    border-radius: 0.85rem;
    padding: 1rem;
    background: hsl(var(--card) / 0.55);
  }
</style>

---
/**
 * Processed inline article image.
 *
 * Article images belong in src/assets/articles so Astro can optimize them.
 * The first ArticleImage in the body is also the article cover. Articles must
 * contain at least one of these processed local images.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width = 800, height = 450, class: className = 'my-6 w-full rounded-lg border border-border' } = Astro.props;
---

<figure class="my-6">
  <Image src={src} alt={alt} width={width} height={height} format="webp" loading="lazy" decoding="async" class={className} />
</figure>

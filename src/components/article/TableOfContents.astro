---
/**
 * TableOfContents — auto-generated TOC from rendered MDX headings.
 *
 * Shows H2/H3 as a clickable anchor list. On desktop it's a sticky aside
 * inside the article; on mobile it's a collapsible `<details>` element.
 *
 * Includes scrollspy: the link matching the heading currently in view is
 * highlighted (a `data-active` attribute + CSS below). Pure IntersectionObserver,
 * ~20 lines of vanilla JS, no framework runtime.
 *
 * The `headings` prop comes from Astro's `render()` return value:
 *   const { Content, headings } = await render(entry);
 *
 * Only depth 2 and 3 are shown (H1 is the article title, H4+ is too granular).
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  /** Section heading (locale JSON shared.onThisPage). */
  heading?: string;
  /**
   * Breakpoint where the sticky desktop card takes over from the collapsible
   * <details>. Wiki articles use the default 'lg' (TOC sits beside the
   * content there); handbook chapters use 'xl' (their 3-column layout with
   * the manual tree only fits from 1280px up).
   */
  desktopAt?: 'lg' | 'xl';
}
const { headings, heading = 'On this page', desktopAt = 'lg' } = Astro.props;
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const desktopClass = desktopAt === 'xl' ? 'hidden xl:block' : 'hidden lg:block';
const mobileClass = desktopAt === 'xl' ? 'xl:hidden' : 'lg:hidden';
---

{tocItems.length > 0 && (
  <nav aria-label={heading} class="toc-nav not-prose">
    {/* Desktop: sticky card */}
    <div class:list={[desktopClass, 'sticky top-20 rounded-lg border border-border bg-card p-4']}>
      <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {heading}
      </p>
      <ul data-toc-list class="toc-list max-h-[28rem] space-y-1.5 overflow-y-auto pr-1 text-sm leading-5">
        {tocItems.map((h) => (
          <li class={h.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              title={h.text}
              class="toc-link block break-words border-l-2 border-transparent pl-2 text-muted-foreground transition-colors hover:text-nav hover:underline"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {/* Mobile: collapsible */}
    <details class:list={[mobileClass, 'rounded-lg border border-border bg-card p-3']}>
      <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wider text-muted-foreground">
        {heading}
      </summary>
      <ul data-toc-list class="toc-list mt-3 max-h-[28rem] space-y-1.5 overflow-y-auto pr-1 text-sm leading-5">
        {tocItems.map((h) => (
          <li class={h.depth === 3 ? 'ml-4' : ''}>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              title={h.text}
              class="toc-link block break-words border-l-2 border-transparent pl-2 text-muted-foreground transition-colors hover:text-nav hover:underline"
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </nav>
)}

<style is:global>
  /* Scrollspy active state — applied by the IntersectionObserver script. */
  .toc-link {
    /* Lock text metrics so scrollspy cannot change wrapping or card height. */
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.25rem;
    letter-spacing: normal;
  }

  .toc-nav a[data-active] {
    color: hsl(var(--brand-text));
    border-left-color: hsl(var(--brand-text));
  }

  .toc-list {
    scrollbar-width: thin;
    scrollbar-gutter: stable;
  }
</style>

<script>
  // Scrollspy: highlight the TOC link whose heading is currently in view.
  // The last heading scrolled past wins (typical wiki/MDN behavior).
  (() => {
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a[data-toc-link]'));
    if (links.length === 0) return;

    const headingIds = links.map((l) => l.getAttribute('data-toc-link') || '');
    const headings = headingIds
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    // Keep the first 10 entries visible, counting their real wrapped height.
    // Long headings may span lines; a fixed pixel height would otherwise show
    // fewer than 10 entries or clip the tenth item.
    const fitTenTocItems = () => {
      for (const list of document.querySelectorAll<HTMLUListElement>('ul[data-toc-list]')) {
        const items = Array.from(list.children).filter((child): child is HTMLLIElement => child instanceof HTMLLIElement);
        if (items.length <= 10) {
          list.style.maxHeight = 'none';
          list.style.overflowY = 'visible';
          continue;
        }
        const listTop = list.getBoundingClientRect().top;
        const tenthBottom = items[9].getBoundingClientRect().bottom;
        list.style.maxHeight = `${Math.ceil(tenthBottom - listTop)}px`;
        list.style.overflowY = 'auto';
      }
    };
    requestAnimationFrame(fitTenTocItems);
    window.addEventListener('resize', fitTenTocItems, { passive: true });

    const setActive = (id: string) => {
      for (const link of links) {
        if (link.getAttribute('data-toc-link') === id) {
          link.setAttribute('data-active', '');
        } else {
          link.removeAttribute('data-active');
        }
      }
    };

    // Track which heading section the reader is in.
    let currentId = headingIds[0];
    const onScroll = () => {
      // The heading whose top is closest above the viewport line wins.
      const line = window.scrollY + 120;
      let active = headingIds[0];
      for (const h of headings) {
        if (h.offsetTop <= line) active = h.id;
      }
      if (active !== currentId) {
        currentId = active;
        setActive(active);
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

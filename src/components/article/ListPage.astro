---
/**
 * List page — shows all articles in a category for a locale.
 *
 * Behavior (PRD §9.3): does NOT fall back to English. If the locale has
 * no articles in this category, the empty state is shown.
 */
import { Icon } from 'astro-icon/components';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import ArticleCover from '~/components/article/ArticleCover.astro';
import { NAVIGATION_CONFIG } from '~/config/navigation';
import { type Locale } from '~/i18n/routing';
import { getUi } from '~/i18n/ui';
import { extractFirstBodyImage, getEntriesByCategory, parseEntryId } from '~/lib/content';
import { itemListJsonLd, pageTitle, simpleBreadcrumbJsonLd } from '~/lib/seo';
import { detailPath, homeUrl, listPath } from '~/lib/url';
import { resolveArticleImage } from '~/lib/article-images';

interface Props {
  locale: Locale;
  category: string;
  /** hreflang alternates (built by the route page). */
  alternates?: Array<{ hreflang: string; href: string }>;
}
const { locale, category, alternates = [] } = Astro.props;
const ui = getUi(locale);
const nav = ui.nav as Record<string, string>;
const shared = ui.shared as unknown as Record<string, any>;
const overview = (
  ui.overview as Record<string, { overviewTitle: string; overviewDescription: string }>
)[category];
const navItem = NAVIGATION_CONFIG.find((n) => n.key === category);

const title = overview?.overviewTitle ?? nav[category] ?? category;
// Localized default (locale JSON shared.defaultListDescription) — a hardcoded
// English sentence here would leak into every locale the moment a fork adds
// a 5th category without an overview entry.
const description =
  overview?.overviewDescription ??
  String(shared.defaultListDescription ?? '').replace('{title}', title) ??
  `${title}`;

const entries = await getEntriesByCategory(category, locale);
const entriesByPath = new Map<string, (typeof entries)[number]>(
  entries.map((entry) => {
    const slug = parseEntryId(entry.id)?.slug ?? '';
    return [`/${category}/${slug}`, entry] as const;
  }),
);
const subnavigationSections = (navItem?.subnavigations ?? [])
  .map((subnavigation) => ({
    key: subnavigation.subnavKey,
    label: subnavigation.label,
    entries: subnavigation.paths.flatMap((path) => {
      const entry = entriesByPath.get(path.replace(/\/$/, ''));
      return entry ? [entry] : [];
    }),
  }))
  .filter((section) => section.entries.length > 0);
const assignedEntries = new Set(subnavigationSections.flatMap((section) => section.entries));
const unassignedEntries = entries.filter((entry) => !assignedEntries.has(entry));
const articleSections = subnavigationSections.length > 0
  ? [
      ...subnavigationSections,
      ...(unassignedEntries.length > 0
        ? [{ key: 'other', label: shared.other ?? 'Other', entries: unassignedEntries }]
        : []),
    ]
  : [{ key: 'all', label: '', entries }];
const fallbackImageByCategory: Record<string, string> = {
  guides: '/images/home/guide-card.svg',
  builds: '/images/home/reference-card.svg',
  items: '/images/home/items-card.svg',
  maps: '/images/home/reference-card.svg',
  bosses: '/images/home/boss-card.svg',
  'tier-list': '/images/home/reference-card.svg',
  news: '/images/home/guide-card.svg',
  codes: '/images/home/items-card.svg',
};
const fallbackImage = fallbackImageByCategory[category] ?? '/images/home/reference-card.svg';

const jsonLd = [
  // Empty ItemList (itemListElement: []) is invalid structured data — only
  // inject when the list actually has entries (breadcrumb stays either way).
  ...(entries.length > 0
    ? [
        itemListJsonLd({
          category,
          categoryLabel: title,
          locale,
          items: entries.map((e) => {
            const slug = parseEntryId(e.id)?.slug ?? '';
            return { title: e.data.title, slug };
          }),
        }),
      ]
    : []),
  simpleBreadcrumbJsonLd({
    pageLabel: title,
    path: listPath(category, locale),
    locale,
    homeLabel: nav.home,
  }),
];
---

<!-- An empty list is a ~100-word thin-content page (NMS /starships was indexed
     as one). noindex keeps it out of Google until real articles exist; the
     sitemap filter excludes the same paths (astro.config.ts). -->
<LocaleLayout
  locale={locale}
  title={pageTitle(title)}
  description={description}
  alternates={alternates}
  jsonLd={jsonLd}
  noindex={entries.length === 0}
>
  <div class="space-y-6">
    <header>
      <nav class="text-sm text-muted-foreground" aria-label="breadcrumb">
        <a href={homeUrl(locale)} class="hover:text-nav">{nav.home}</a>
        <span class="mx-1">/</span>
        <span class="text-foreground">{title}</span>
      </nav>
      <div class="mt-2 flex items-center gap-3">
        {navItem && <Icon name={navItem.icon} class="h-7 w-7 text-nav" />}
        <h1 class="text-3xl font-extrabold tracking-tight">{title}</h1>
      </div>
      <p class="mt-2 max-w-2xl text-muted-foreground">{description}</p>
    </header>

    {
      entries.length === 0 ? (
        <div class="rounded-lg border border-dashed bg-card p-12 text-center">
          <Icon name="lucide:inbox" class="mx-auto h-10 w-10 text-muted-foreground" />
          <p class="mt-3 text-muted-foreground">{shared.noArticles}</p>
        </div>
      ) : (
        <div class="space-y-10">
          {articleSections.map((section) => (
            <section id={section.key === 'all' ? undefined : section.key} class="scroll-mt-24 space-y-4">
              {section.label && <h2 class="text-2xl font-bold tracking-tight">{section.label}</h2>}
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {section.entries.map((entry) => {
                  const slug = parseEntryId(entry.id)?.slug ?? '';
                  const coverRef = extractFirstBodyImage(entry.body ?? '');
                  const cover = coverRef ? resolveArticleImage(coverRef) : undefined;
                  return (
                    <a href={detailPath(category, slug, locale)} class="card group overflow-hidden p-0 transition hover:-translate-y-0.5 hover:border-nav/60 hover:shadow-lg">
                      {cover ? (
                        <ArticleCover src={cover} title={entry.data.title} alt={entry.data.title} class="aspect-video w-full transition duration-300 group-hover:scale-[1.02]" />
                      ) : (
                        <img src={fallbackImage} alt={entry.data.title} class="aspect-video w-full object-cover transition duration-300 group-hover:scale-[1.02]" loading="lazy" />
                      )}
                      <div class="p-5">
                        <h2 class="font-semibold leading-snug">{entry.data.title}</h2>
                        <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">
                          {entry.data.description}
                        </p>
                        <p class="mt-3 text-xs text-muted-foreground">
                          {entry.data.lastModified
                            ? `${shared.lastUpdated}: ${entry.data.lastModified.toLocaleDateString(locale, { timeZone: 'UTC' })}`
                            : `${shared.publishedOn}: ${entry.data.date.toLocaleDateString(locale, { timeZone: 'UTC' })}`}
                        </p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </section>
          ))}
        </div>
      )
    }
  </div>
</LocaleLayout>
